              "raw": "{\n  \"ref\": \"NFE-NORMAL-{{$timestamp}}\",\n  \"ambiente\": \"homologacao\", \"natureza_operacao\": \"venda\",\n  \"finalidade\": \"normal\",\n  \"presenca\": \"presencial\",\n\n  \"destinatario\": {\n    \"documento\": \"45762835880\",\n    \"nome\": \"NF-E EMITIDA EM AMBIENTE DE HOMOLOGACAO - SEM VALOR FISCAL\",\n    \"indicador_ie\": \"nao_contribuinte\",\n    \"endereco\": {\n      \"logradouro\": \"Rua das Flores\",\n      \"numero\": \"123\",\n      \"bairro\": \"Centro\",\n      \"codigo_municipio\": \"3550308\",\n      \"municipio\": \"São Paulo\",\n      \"uf\": \"SP\",\n      \"cep\": \"01001000\"\n    }\n  },\n\n  \"itens\": [\n    {\n      \"codigo\": \"123\",\n      \"descricao\": \"NFCe - Homologacao\",\n      \"quantidade\": 1,\n      \"valor_unitario\": 1.00,\n      \"unidade\": \"UN\",\n      \"gtin\": \"SEM GTIN\",\n      \"ncm\": \"22030000\",\n      \"cfop\": \"5102\",\n      \"cest\": \"0302100\",\n\n      \"tributacao\": {\n        \"origem\": \"0\",\n\n        \"icms\": {\n          \"csosn\": \"102\"\n        },\n\n        \"pis\": {\n          \"cst\": \"99\",\n          \"aliquota\": 1.65\n        },\n\n        \"cofins\": {\n          \"cst\": \"01\",\n          \"aliquota\": 7.60\n        },\n\n        \"ibs_cbs\": {\n          \"cst\": \"000\",\n          \"cClassTrib\": \"000001\",\n          \"pIBSUF\": 0.10,\n          \"pIBSMun\": 0.00,\n          \"pCBS\": 0.90,\n\n          \"uf\": {\n            \"pRedAliq\": 0,\n            \"pAliqEfet\": 0,\n            \"pDif\": 0,\n            \"vDif\": 0,\n            \"vDevTrib\": 0\n          },\n\n          \"mun\": {\n            \"pRedAliq\": 0,\n            \"pAliqEfet\": 0,\n            \"pDif\": 0,\n            \"vDif\": 0,\n            \"vDevTrib\": 0\n          },\n\n          \"cbs\": {\n            \"pRedAliq\": 0,\n            \"pAliqEfet\": 0,\n            \"pDif\": 0,\n            \"vDif\": 0,\n            \"vDevTrib\": 0\n          }\n        }\n      }